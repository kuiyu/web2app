{
  // ============================================================
  //  WebAppLauncher 配置文件
  //  字段用小写（currentApp / apps / id / source / launch / url / window），
  //  程序已通过 [JsonPropertyName] 显式映射 + 大小写不敏感双重支持，大小写均可。
  //
  //  规则速览：
  //   · currentApp : 启动时默认打开哪个应用（填下面 apps 里某个 id）
  //   · apps[]     : 应用列表，每个应用含义见下方注释
  //   · window     : 窗口外观
  //
  //  单个应用字段：
  //   id     : 唯一标识（不可重复）
  //   name   : 在“应用列表/状态”里显示的名字
  //   title  : 窗口标题栏文字
  //   source : 要显示的 Web 内容，三选一：
  //            - 本地相对路径  "apps/ai/index.html"   （相对本程序目录）
  //            - 本地绝对路径  "file:///C:/xxx/index.html"
  //            - 远程网址      "https://www.deepseek.com"
  //   launch : 【可选】启动本应用前要在本机运行的程序命令
  //            （如 "node server.js"、"explorer.exe"、"AspNetCoreServer.exe --port 63000"）
  //            对 AspNetCoreServer：--port 必填；--staticDir 可省略，省略时自动用 source 的目录作为静态根
  //            例：source="apps/ai/index.html" + launch="AspNetCoreServer.exe --port 63000"
  //                → 等效于 "... --staticDir apps/ai"
  //            若 launch 含 --port，则 url 可省略：程序自动用 http://localhost:{port}/index.html 作为打开地址
  //   url    : 【可选】最终要打开的网址。两种情况：
  //            (a) 省略时：若 launch 带 --port，自动推导为 http://localhost:{port}/index.html；否则退回 source
  //            (b) 显式填写时：直接打开它（如远程 "https://..." 或本机 "http://localhost:8080"），优先级高于 source
  //
  //  显示规则：最终打开的页面 = 推导出的后端地址(url 或 --port) 优先；否则 source
  // ============================================================

  "currentApp": "deepseek",

  "apps": [
    {
      // 本地 SPA + 反向代理：程序自动启动 AspNetCoreServer 托管 apps/ai 到 63000 端口，
      // 并把 /api/* 请求转发到上游真实后端（解决无后端环境/跨域问题）。
      // AspNetCoreServer 支持 --proxy 参数：--proxy <前缀>=<上游地址>
      //   - 可多次使用，或用分号分隔：--proxy "/api=http://localhost:8080;/ws=http://localhost:9000"
      //   - 匹配前缀的请求会被转发到上游，其余请求走本地静态文件
      //   - 已自动加 CORS 头，SPA 可直接跨域访问
      // 下方示例把 /api 代理到 http://localhost:8080；如无可代理后端，删除 --proxy 即可。
      "id": "ai-web",
      "name": "AI Web 应用",
      "title": "AI Web 应用",
      "source": "apps/ai/index.html",
      "launch": "AspNetCoreServer.exe --port 63000 --proxy /api=http://localhost:8080"
    },
    {
      // 本地静态页演示（后端进程统一以隐藏窗口运行，不弹 cmd）
      "id": "web-demo",
      "name": "演示应用",
      "title": "演示应用",
      "source": "apps/app2/index.html",
      "launch": ""
     
    },
    {
      // 与 ai-web 相同本地 SPA，作为另一个入口
      "id": "ai-web-2",
      "name": "AI Web 应用 (63000)",
      "title": "AI Web 应用 (63000)",
      "source": "apps/ai/index.html",
      "launch": "AspNetCoreServer.exe --port 63000"
    },
    {
      // 直接打开远程网址（不弹资源管理器）
      "id": "deepseek",
      "name": "DeepSeek",
      "title": "DeepSeek",
      "source": "https://www.deepseek.com",
      "launch": ""
    }
    
  ],

  "window": {
    "width": 1200,
    "height": 800,
    "startPosition": "CenterScreen",
    "disableContextMenu": true
  }
}
